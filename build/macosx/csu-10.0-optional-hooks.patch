+#ifdef CRT1
+#include <mach-o/dyld.h>
+/* An allocated common placeholder conflicts with the real entry point when
+ * an Objective-C/Carbon component is loaded after main, especially with
+ * DYLD_BIND_AT_LAUNCH. Resolve optional hooks without exporting placeholders. */
+static void *
+zr_startup_hook(const char *name)
+{
+    if (NSIsSymbolNameDefined(name))
+        return NSAddressOfSymbol(NSLookupAndBindSymbol(name));
+    return 0;
+}
+#else
 asm(".comm __objcInit, 4");
 asm(".comm __cplus_init, 4");
 asm(".comm __carbon_init, 4");
 extern void _objcInit(void);
 extern void _cplus_init(void);
 extern void _carbon_init(int argc, char **argv);
+#endif
 
