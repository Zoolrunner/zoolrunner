		jdsample-8.c \
		jdsample-12.c \
		jdsample-16.c \
		jdtrans.c \
		jerror.c \
		jfdctflt.c \
		jfdctfst-8.c \
		jfdctfst-12.c \
		jfdctint-8.c \
		jfdctint-12.c \
		jidctflt-8.c \
		jidctflt-12.c \
		jidctfst-8.c \
