EXPORTS		= \
		jconfig.h \
		jconfigint.h \
		jerror.h \
		jinclude.h \
		jmorecfg.h \
		jpeglib.h \
		jpegapicomp.h \
		jpegint.h \
		jversion.h \
		$(NULL)

# Keep the bundled libjpeg-turbo integration on the generic C path by
# default.  SIMD can be wired in later as an optional per-target path.
DEFINES		+= -DNO_GETENV -DNO_PUTENV

# need static lib for some of the libimg componentry to link properly
FORCE_STATIC_LIB = 1

include $(topsrcdir)/config/rules.mk
