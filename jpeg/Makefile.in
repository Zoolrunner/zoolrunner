DEPTH		= ..
topsrcdir	= @top_srcdir@
srcdir		= @srcdir@
VPATH		= @srcdir@

include $(DEPTH)/config/autoconf.mk

MODULE		= jpeg
LIBRARY_NAME	= mozjpeg

ifeq ($(OS_ARCH),WINNT)
LIBRARY_NAME	= jpeg$(MOZ_BITS)$(VERSION_NUMBER)
endif

GRE_MODULE	= 1

CSRCS		= \
		jaricom.c \
		jcapimin.c \
		jcapistd-8.c \
		jcapistd-12.c \
		jcapistd-16.c \
		jcarith.c \
		jccoefct-8.c \
		jccoefct-12.c \
		jccolor-8.c \
		jccolor-12.c \
		jccolor-16.c \
		jcdctmgr-8.c \
		jcdctmgr-12.c \
		jcdiffct-8.c \
		jcdiffct-12.c \
		jcdiffct-16.c \
		jchuff.c \
		jcicc.c \
		jcinit.c \
		jclhuff.c \
		jclossls-8.c \
		jclossls-12.c \
		jclossls-16.c \
		jcmainct-8.c \
		jcmainct-12.c \
		jcmainct-16.c \
		jcmarker.c \
		jcmaster.c \
		jcomapi.c \
		jcparam.c \
		jcphuff.c \
		jcprepct-8.c \
		jcprepct-12.c \
		jcprepct-16.c \
		jcsample-8.c \
		jcsample-12.c \
		jcsample-16.c \
		jctrans.c \
		jdapimin.c \
		jdapistd-8.c \
		jdapistd-12.c \
		jdapistd-16.c \
		jdarith.c \
		jdatasrc.c \
		jdatadst.c \
		jdcoefct-8.c \
		jdcoefct-12.c \
		jdcolor-8.c \
		jdcolor-12.c \
		jdcolor-16.c \
		jddctmgr-8.c \
		jddctmgr-12.c \
		jddiffct-8.c \
		jddiffct-12.c \
		jddiffct-16.c \
		jdhuff.c \
		jdicc.c \
		jdinput.c \
		jdlhuff.c \
		jdlossls-8.c \
		jdlossls-12.c \
		jdlossls-16.c \
		jdmainct-8.c \
