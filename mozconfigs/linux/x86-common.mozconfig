# Shared Oracle Linux 8 / GCC Toolset 14 configuration.
ZR_TOPSRCDIR=`cd "${MOZCONFIG%/*}/../../.." && pwd`
ZR_LINUX_TOOLKIT=${ZR_LINUX_TOOLKIT:-gtk2}
ZR_TOOLKIT_SUFFIX=
if test "$ZR_LINUX_TOOLKIT" = xlib; then
  ZR_TOOLKIT_SUFFIX=-xlib
fi
ZR_OBJDIR=${ZR_OBJDIR:-$ZR_TOPSRCDIR/obj-zoolrunner-linux-$ZR_LINUX_ARCH-$ZR_LINUX_APP$ZR_TOOLKIT_SUFFIX}
mk_add_options MOZ_OBJDIR="$ZR_OBJDIR"
mk_add_options MOZ_MAKE_FLAGS="-j${ZR_BUILD_JOBS:-3}"
mk_add_options BOOTSTRAP_IN_TREE_LIBIDL=1
# Retain NSS diagnostics without promoting legacy unused-temporary warnings
# to errors under GCC 14. Compiler errors remain fatal.
mk_add_options 'export NSS_ENABLE_WERROR=0'
# Xlib disables the toolkit probes that would otherwise locate pkg-config;
# bundled Cairo still needs its FreeType header flags for SVG and canvas.
PKG_CONFIG=/usr/bin/pkg-config
export PKG_CONFIG
ZR_TOOLSET=/opt/rh/gcc-toolset-14/root/usr/bin
CC="$ZR_TOOLSET/gcc"
CXX="$ZR_TOOLSET/g++"
HOST_CC="$ZR_TOOLSET/gcc"
HOST_CXX="$ZR_TOOLSET/g++"
AR="$ZR_TOOLSET/ar"
RANLIB="$ZR_TOOLSET/ranlib"
HOST_AR="$AR"
HOST_RANLIB="$RANLIB"
HOST_CFLAGS="-std=gnu89 -fcommon"
HOST_CXXFLAGS="-std=gnu++98 -fcommon"
CFLAGS="-std=gnu89 -fcommon"
CXXFLAGS="-std=gnu++98 -fcommon -fpermissive"
LDFLAGS=
if test "$ZR_LINUX_ARCH" = i686; then
  CC="$ZR_TOPSRCDIR/mozconfigs/linux/i686/gcc"
  CXX="$ZR_TOPSRCDIR/mozconfigs/linux/i686/g++"
  CROSS_COMPILE=1
  PKG_CONFIG_LIBDIR=/usr/lib/pkgconfig:/usr/share/pkgconfig
  export CROSS_COMPILE PKG_CONFIG_LIBDIR
  ac_add_options --target=i686-pc-linux-gnu
else
  ac_add_options --target=x86_64-pc-linux-gnu
fi
ZR_LIBIDL_PREFIX="$ZR_OBJDIR/build/unix/libIDL-prefix"
LIBIDL_CONFIG="$ZR_LIBIDL_PREFIX/bin/libIDL-config-2"
ZR_HOST_LIBIDL_CONFIG="$LIBIDL_CONFIG"
LIBIDL_CONFIG="$ZR_TOPSRCDIR/build/linux/host-libIDL-config"
HOST_LIBIDL_CONFIG="$LIBIDL_CONFIG"
export ZR_HOST_LIBIDL_CONFIG
PATH="$ZR_LIBIDL_PREFIX/bin:$ZR_TOOLSET:$PATH"
PKG_CONFIG_PATH="$ZR_LIBIDL_PREFIX/lib/pkgconfig:${PKG_CONFIG_PATH-}"
export PKG_CONFIG_PATH
export CC CXX HOST_CC HOST_CXX AR RANLIB HOST_AR HOST_RANLIB
export CFLAGS CXXFLAGS LDFLAGS HOST_CFLAGS HOST_CXXFLAGS
export LIBIDL_CONFIG HOST_LIBIDL_CONFIG PATH
ac_add_options --enable-application="$ZR_LINUX_APP"
ac_add_options --enable-default-toolkit="$ZR_LINUX_TOOLKIT"
if test "$ZR_LINUX_TOOLKIT" = xlib; then
  ac_add_options --disable-freetype2
fi
ac_add_options --enable-optimize=-O2
ac_add_options --disable-debug
ac_add_options --disable-tests
ac_add_options --disable-installer
ac_add_options --disable-updater
ac_add_options --disable-gnomevfs
ac_add_options --disable-dbus
ac_add_options --disable-pango
ac_add_options --without-system-jpg
ac_add_options --without-system-zlib
ac_add_options --enable-crypto
ac_add_options --enable-svg
ac_add_options --enable-canvas
ac_add_options --disable-javaxpcom
